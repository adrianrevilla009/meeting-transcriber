# Por defecto el token es el MISMO MT_API_TOKEN del módulo 1 (docker-compose lo pasa): la UI usa un solo token.
RTA_API_TOKEN=cambia-esto
RTA_TRANSCRIBER_URL=http://api:8000
RTA_SHIELD_URL=http://privacy-shield:8100
RTA_SHIELD_TOKEN=            # = ANON_API_TOKEN de privacy-shield
RTA_SHIELD_PROVIDER=         # vacío = proveedor por defecto de privacy-shield
RTA_OLLAMA_URL=http://localhost:11434
RTA_OLLAMA_MODEL=qwen2.5:3b
RTA_CLASSIFIER=ollama        # ollama | rules
RTA_USER_NAMES=              # tus nombres/apodos: "Adrián, Adri"
RTA_PROFILE=                 # contexto tuyo para las respuestas (va por privacy-shield)
RTA_AUTO_ANSWER=true
RTA_ANSWER_COOLDOWN_SECONDS=15
